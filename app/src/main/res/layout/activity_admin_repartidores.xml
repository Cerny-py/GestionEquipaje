<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".Admin.AdminRepartidores">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Repartidores"
        android:textColor="@color/color_primario"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registra el correo de Google de cada repartidor"
        android:textColor="#757575"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etNombreRepartidor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Nombre"
        android:inputType="textPersonName|textCapWords" />

    <EditText
        android:id="@+id/etCorreoRepartidor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Correo de Google"
        android:inputType="textEmailAddress" />

    <Button
        android:id="@+id/btnRegistrarRepartidor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#FF6D00"
        android:text="Registrar repartidor" />

    <ProgressBar
        android:id="@+id/progresoRepartidores"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvVacioRepartidores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Aún no hay repartidores registrados"
        android:textColor="#757575"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lvRepartidores"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Toca un repartidor para activarlo, desactivarlo o eliminarlo"
        android:textColor="#757575"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnVolverRepartidores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/color_primario"
        android:text="Volver" />
</LinearLayout>