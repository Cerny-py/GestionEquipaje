<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_primario"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    tools:context=".DiagnosticoActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Diagnóstico"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnErrorNoFatal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/color_secundario"
        android:text="Registrar error no fatal" />

    <Button
        android:id="@+id/btnCrashPrueba"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#B00020"
        android:text="Provocar crash de prueba" />

    <Button
        android:id="@+id/btnVolverDiagnostico"
        android:layout_width="120dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#181616"
        android:text="Volver" />

</LinearLayout>