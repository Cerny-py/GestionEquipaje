<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDestinatarioItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/color_primario"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Juan Pérez" />

            <TextView
                android:id="@+id/tvEstadoItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#757575"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="PENDIENTE" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTipoEquipajeItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#757575"
            android:textSize="14sp"
            tools:text="Maleta · 12.0 kg" />

        <TextView
            android:id="@+id/tvTarifaItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#757575"
            android:textSize="14sp"
            tools:text="Tarifa: $6.000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:id="@+id/ivActualizarEncomienda"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="120dp"
                android:src="@drawable/icono_actualizar"
                android:tint="@color/color_primario" />

            <ImageView
                android:id="@+id/ivEliminarEncomienda"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="30dp"
                android:src="@drawable/icono_eliminar"
                android:tint="#FF2C2C" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>